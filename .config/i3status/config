general {
	output_format = "i3bar"
	colors = true
	color_good = "#58dca8"
	color_bad  = "#cc5446"
	color_degraded = "#fae09b"
	interval = 5
}

order += "disk /home"
order += "ethernet enp5s0"
order += "ethernet tun0"
order += "memory"
order += "cpu_usage"
order += "time"

ethernet enp5s0 {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

ethernet tun0 {
	format_up = "VPN: %ip (%speed)"
	format_down = "VPN: down"
}

time {
        format = "%H:%M:%S %d.%m.%Y "
}

cpu_usage {
        format = "CPU: %usage"
}

memory {
        format = "%used"
        threshold_degraded = "10%"
        format_degraded = "MEMORY: %free"
}

disk "/home" {
        format = "/home: %avail"
}

read_file uptime {
        path = "/proc/uptime"
}
